rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{responseId} {
      // Responses are write-only from the public page. Keep records private.
      allow get, list, update, delete: if false;
      allow create: if request.resource.data.keys().hasAll([
          'name', 'answer', 'timestamp', 'userAgent'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'answer', 'timestamp', 'userAgent'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.answer in ['YES', 'NO']
        && request.resource.data.timestamp == request.time
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500;
    }
  }
}
